const fs = require("node:fs");

type GameField = Array<string[]>;
type PathStep = {
    position: Cord;
    direction: Cord;
};

class Cord {
    x: number;
    y: number;

    constructor(x: number, y: number) {
        this.x = x;
        this.y = y;
    }

    add(cord: Cord) {
        return new Cord(this.x + cord.x, this.y + cord.y);
    }

    isEqual(cord: Cord) {
        return this.x === cord.x && this.y === cord.y;
    }

    rotate() {
        if (this.x !== 0) {
            switch (this.x) {
                // if right go down
                case 1:
                    this.x = 0;
                    this.y = 1;
                    break;

                // if left go up
                case -1:
                    this.x = 0;
                    this.y = -1;
                    break;
            }
        } else {
            switch (this.y) {
                // if down go left
                case 1:
                    this.x = -1;
                    this.y = 0;
                    break;

                // if up go right
                case -1:
                    this.x = 1;
                    this.y = 0;
                    break;
            }
        }
    }

    outsideOfBounds() {
        return (
            this.x < 0 ||
            this.x >= gameField[0].length ||
            this.y < 0 ||
            this.y >= gameField.length
        );
    }
}

function readData(path) {
    let data = fs.readFileSync(path, "utf8");

    const gameField: GameField = [];
    let guardPosition: Cord | null = null;

    data.split("\n").forEach((line: string, y) => {
        const row: string[] = [];
        for (let x = 0; x < line.length; x++) {
            const char = line[x];

            if (char === "^") {
                guardPosition = new Cord(x, y);
            }
            row.push(char);
        }
        gameField.push(row);
    });

    return { gameField, guardPosition };
}

function printGameField(gf: GameField) {
    gf.forEach((row) => {
        let line = "";
        row.forEach((char) => {
            line += char;
        });
        console.log(line);
    });
}

var { gameField, guardPosition } = readData("./test.txt");

function calculatePath() {
    let direction = new Cord(0, -1); // 1: right/down | -1: left,up
    let position = guardPosition;
    const path: PathStep[] = [
        {
            direction,
            position,
        },
    ];

    let newTile;
    do {
        let newPos = position.add(direction);
        newTile = gameField[newPos.y]?.[newPos.x];

        if (newTile === "." || newTile === "^") {
            path.push({
                position: newPos,
                direction: new Cord(direction.x, direction.y),
            });
            position = newPos;
        } else if (newTile === "#") {
            direction.rotate();
        }
    } while (newTile);

    return path;
}

const path = calculatePath();

// render path
path.forEach((step) => {
    const cord = step.position;
    // const char = step.direction.x !== 0 ? "-" : "|"
    const char = "X";
    gameField[cord.y][cord.x] = char;
});

let distinctLocations = 0;
gameField.forEach((row) => {
    row.forEach((tile) => {
        if (tile === "X") {
            distinctLocations++;
        }
    });
});

printGameField(gameField);
console.log(distinctLocations);

// all possible loops

// check if a path >= 2 is parallel to current position, if so place obstacle in front

const loopObstacles: Cord[] = [];
path.forEach((step, stepIndex) => {
    const gameFieldInstance = { ...gameField };
    const direction = new Cord(step.direction.x, step.direction.y);
    let position = step.position;
    const instanceSteps: PathStep[] = [
        {
            direction,
            position,
        },
    ];

    direction.rotate();

    let newTile;
    do {
        let newPos = position.add(direction);
        newTile = gameFieldInstance[newPos.y]?.[newPos.x];

        if (instanceSteps.find((p, i) => p.position.isEqual(position))) {
            loopObstacles.push(step.position.add(step.direction));
            return;
        }

        if (newTile === "." || newTile === "^" || newTile === 'X') {
            instanceSteps.push({
                position: newPos,
                direction: new Cord(direction.x, direction.y),
            });
            position = newPos;
        } else if (newTile === "#") {
            direction.rotate();
        }
    } while (newTile);
});
